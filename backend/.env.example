# Hugging Face inference
HF_TOKEN=hf_your_token_here
HF_TEXT_MODEL=Qwen/Qwen3-8B
HF_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Krea-dev
HF_DTYPE=bfloat16
HF_QUANTIZE_4BIT=true
HF_DEVICE=cuda
HF_MAX_NEW_TOKENS=4096
HF_IMAGE_WIDTH=1024
HF_IMAGE_HEIGHT=1024
HF_IMAGE_STEPS=28
HF_IMAGE_GUIDANCE=4.5

# Application/database settings
JWT_SECRET=replace_with_a_long_random_secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=marketai
